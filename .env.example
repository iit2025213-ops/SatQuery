# SatQuery AI Configuration
# Copy to .env and fill in values

# OpenAI / LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=
# OPENAI_TEMPERATURE=0.1
# OPENAI_MAX_RETRIES=2

# Agent limits
MAX_STEPS=20
MAX_REPLANS=3
MAX_RETRIES_PER_TASK=2

# Logging
LOG_LEVEL=INFO

# ============================================================
# API & Security
# ============================================================

# The public URL where the SatQuery Brain API is deployed
BRAIN_BASE_URL=https://<your-deployed-domain>

# Comma-separated list of allowed frontend origins (CORS)
# Leave as * for open access, or specify domains: https://app.example.com
CORS_ORIGINS=*


# ============================================================
# Specialist Model Endpoints
# Leave empty until each model is independently hosted.
# The application starts normally with all endpoints empty.
# Attempting an unavailable capability returns a structured
# ENDPOINT_NOT_CONFIGURED observation to the LLM.
# ============================================================

# GeoChat (VLM: scene interpretation, VQA, captioning, grounding)
GEOCHAT_ENDPOINT=
GEOCHAT_API_KEY=
GEOCHAT_TIMEOUT_SECONDS=60

# ChangeFormer (bi-temporal change detection)
CHANGEFORMER_ENDPOINT=
CHANGEFORMER_API_KEY=
CHANGEFORMER_TIMEOUT_SECONDS=120

# Prithvi (multispectral foundation model)
PRITHVI_ENDPOINT=
PRITHVI_API_KEY=
PRITHVI_TIMEOUT_SECONDS=90

# SARMAE (SAR analysis)
SARMAE_ENDPOINT=
SARMAE_API_KEY=
SARMAE_TIMEOUT_SECONDS=90

# SkySense++ (multimodal EO)
SKYSENSE_ENDPOINT=
SKYSENSE_API_KEY=
SKYSENSE_TIMEOUT_SECONDS=120
