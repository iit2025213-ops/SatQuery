# .env.example - Copy to .env and fill in your values

# Backend
BACKEND_URL=http://localhost:8000
BACKEND_PORT=8000
DEBUG=True
APP_NAME=SatQuery AI

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@localhost:5432/satquery

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_FOLDER=satquery-ai

# JWT
JWT_SECRET_KEY=your-super-secret-key-must-be-at-least-32-characters-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Brain (Your Friend's Service)
AI_BRAIN_URL=ws://localhost:8001/brain
AI_BRAIN_TIMEOUT_SECONDS=30

# OpenAI (for future use)
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=gpt-4.1-mini

# CORS Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Logging
LOG_LEVEL=INFO

# Agent Limits
MAX_AGENT_STEPS=20
MAX_REPLANS=3
MAX_RETRIES_PER_TASK=2
MAX_EXECUTION_TIME_SECONDS=3600

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD_SECONDS=3600

# Google Earth Engine
GEE_SERVICE_ACCOUNT_KEY_PATH=secrets/google-earth-engine-key.json
GEE_PROJECT_ID=your-gee-project-id
